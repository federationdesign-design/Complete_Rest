respect. For more information about our privacy practices please visit the privacy policy page.</span></span></span></span> </p>\n</div>\n<div class=\"wpcf7-response-output wpcf7-display-none\"></div></form></div>             </div>\n            </div>\n  <div class=\"clear\"></div>\n        </div>\n    </div>\n    </section>    \n<section class=\"target-section target sectcompanies \" id=\"sectcompanies\">\n\t<div  class=\"accredited\">\n        <hr class=\"hrseparatortop\" />\n\t\t\t\t<h2>Proud members of...</h2>\n\t\t<br class=\"tabseparatortop\" />\n\t\t\t\t<ul class=\"companies\" >\n      <li class=\"licompany\" style=\"display:inline-block;\" >\n           <img class=\"imgcomapny\" src=\"https://www.completerestoration.co.uk/wp-content/uploads/2019/02/qualified_tile_association_tiler_suffolk.png\" >\n                     </li>   \n      <li class=\"licompany\" style=\"display:inline-block;\" >\n           <img class=\"imgcomapny\" src=\"https://www.completerestoration.co.uk/wp-content/uploads/2019/02/Guild-Emblem-Transparent.png\" >\n                     </li>   \n      <li class=\"licompany\" style=\"display:inline-block;\" >\n           <img class=\"imgcomapny\" src=\"https://www.completerestoration.co.uk/wp-content/uploads/2019/02/niceic-logo.png\" >\n                     </li>   \n      <li class=\"licompany\" style=\"display:inline-block;\" >\n           <img class=\"imgcomapny\" src=\"https://www.completerestoration.co.uk/wp-content/uploads/2019/02/MPA-logo.jpg.png\" >\n                     </li>   \n      <li class=\"licompany\" style=\"display:inline-block;\" >\n           <img class=\"imgcomapny\" src=\"https://www.completerestoration.co.uk/wp-content/uploads/2019/02/220px-Gas_Safe_Register.png\" >\n                     </li>   \n           </ul>\n\t\t</div>\n</section>\n<div class=\"clear\"></div>",
