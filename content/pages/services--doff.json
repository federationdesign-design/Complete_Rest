  "renderedHtml": "</div> \n    </div>\n<div id='main' class='all_colors' data-scroll-offset=\"0\">\n<div id=\"av_section_1\" class=\" only-desktop avia-section main_color avia-section-no-padding avia-no-border-styling avia-full-stretch avia-bg-style-scroll  avia-builder-el-0  el_before_av_submenu  avia-builder-el-first   av-minimum-height av-minimum-height-custom container_wrap fullsize\" style=\"background-repeat: no-repeat; background-image: url(\nhttps://www.completerestoration.co.uk/wp-content/uploads/2019/04/doff-image.jpg); background-attachment: scroll; background-position: center center; \" data-section-bg-repeat=\"stretch\"><div class=\"container\" style=\"height:450px\"><main role=\"main\" itemprop=\"mainContentOfPage\" class=\"template-page content  av-content-full alpha units\"><div class=\"post-entry post-entry-type-page post-entry-22\"><div class=\"entry-content-wrapper clearfix\">\n</div></div></main></div></div>\n    <div id=\"av_section_mobile\" class=\" only-mobile\"  style=\"max-height:450px; max-width:100%;\"><img src=\"https://www.completerestoration.co.uk/wp-content/uploads/2019/04/doff-image.jpg\"></div>\n<div class='clear'></div>\n    <div class=\"container\">\n<section class=\"row\" id=\"introductionwelcome\" class=\"introductionwelcome\">\n\t<div  id=\"divintroductionThird\" class=\"divsectiontext\" style=\"margin-bottom:0;text-align:center;\">\n\t\t <br class=\"separatorintro\" />\n\t\t\t  <h1 style=\"margin-bottom:0;padding-bottom:0;\">Doff by Complete Restoration</h1>\n\t\t\t<h2>The Complete Restoration Company use a series of cleaning methods to clean walls and buildings of unwanted paint, moss and algae or even graffiti. </h2>\n       </div> \n       <hr class=\"hrseparatortop\" style=\"margin-top:40px !important;\">\n    <div class=\"clear\"></div>\n    <br class=\"tabseparatortop\" />\n </section>\n    </div>\n<div class=\"clear\"></div>\n<section class=\"row target-section\" id=\"row_columns\" ><a name=\"featured\" class=\"anchor_position\"></a>\n  <div class=\"home-intro-texto\" id=\"landlords-column\">\n    <div class=\"divsectioncontent\"  >\n         <div class=\"inner\">\n            <div id=\"landlords-column-content\" class=\"not-mobile1\">\n                <h4 class='h4_inner'>Specifically, we have been accredited to use the chemical-free and eco-friendly pressure wash system called Doff.</h4>\n              <p>Using exactly the right combination of pressurised water and fine inert powder, the Doff machine and Torc nozzle allow us to clean walls and buildings highly effectively whilst protecting the precious stone or brickwork beneath.</p>\n<p>The system is so highly regarded, Harrods, Westminster Abbey and St Pancras station insisted this system be used to clean their buildings.</p>\n             </div>\n            </div>\n        </div>\n  </div>\n     <div class=\"\"  id=\"tenants-column\">\n<div class=\"\"  style=\"background:#6e6e6d url(https://www.completerestoration.co.uk/wp-content/uploads/2019/02/form_bricks.svg);no-repeat;cover;\">\n         <div class=\"inner\">\n            <div id=\"landlords-column-content\" class=\"not-mobile1\">\n              <h2 id=\"form-title\">Get a Quote Today</h2>\n             <p id=\"form-subtitle\"></p>\n               <div role=\"form\" class=\"wpcf7\" id=\"wpcf7-f521-p1925-o1\" lang=\"en\" dir=\"ltr\">\n<div class=\"screen-reader-response\"></div>\n<form action=\"/services/doff/#wpcf7-f521-p1925-o1\" method=\"post\" class=\"wpcf7-form form-contact\" novalidate=\"novalidate\" id=\"form-contact\">\n<div style=\"display: none;\">\n<input type=\"hidden\" name=\"_wpcf7\" value=\"521\" />\n<input type=\"hidden\" name=\"_wpcf7_version\" value=\"5.1.3\" />\n<input type=\"hidden\" name=\"_wpcf7_locale\" value=\"en\" />\n<input type=\"hidden\" name=\"_wpcf7_unit_tag\" value=\"wpcf7-f521-p1925-o1\" />\n<input type=\"hidden\" name=\"_wpcf7_container_post\" value=\"1925\" />\n<input type=\"hidden\" name=\"g-recaptcha-response\" value=\"\" />\n</div>\n<